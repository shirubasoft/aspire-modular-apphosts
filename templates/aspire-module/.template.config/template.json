{
  "$schema": "http://json.schemastore.org/template",
  "author": "Shirubasoft",
  "classifications": [
    "Aspire",
    "Cloud"
  ],
  "identity": "Shirubasoft.Aspire.ModularAppHosts.Module",
  "name": "Aspire modular AppHost module",
  "shortName": "aspire-module",
  "sourceName": "CatalogModule",
  "preferNameDirectory": false,
  "symbols": {
    "moduleName": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "catalog",
      "description": "Stable module identity used by importing AppHosts.",
      "replaces": "catalog-module-name"
    }
  }
}
