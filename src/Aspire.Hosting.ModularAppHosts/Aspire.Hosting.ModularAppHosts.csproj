<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Composable module import and export support for Aspire AppHosts.</Description>
    <AssemblyName>Shirubasoft.Aspire.ModularAppHosts</AssemblyName>
    <PackageId>Shirubasoft.Aspire.ModularAppHosts</PackageId>
    <PackageTags>aspire;apphost;modules;containers</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Shirubasoft/aspire-modular-apphosts</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Shirubasoft/aspire-modular-apphosts.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
