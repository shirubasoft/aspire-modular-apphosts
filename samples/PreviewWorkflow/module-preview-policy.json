{
  "schemaVersion": 3,
  "modules": [
    {
      "module": "image-push-e2e",
      "repository": "https://github.com/example/sample-module.git",
      "contract": {
        "packageId": "Example.SampleModule.Contract",
        "versionEnvironment": "SampleModuleContractVersion",
        "required": true,
        "published": {
          "source": "https://api.nuget.org/v3/index.json"
        },
        "sourceFallback": {
          "enabled": false
        }
      },
      "images": [
        {
          "resource": "image-push-declared",
          "resourceKind": "container",
          "repositories": [
            "registry.example.test/image-push/declared"
          ],
          "producerRepositories": [
            "https://github.com/example/sample-image-builder.git"
          ],
          "required": true
        },
        {
          "resource": "image-push-factory",
          "resourceKind": "container",
          "repositories": [
            "registry.example.test/image-push/factory"
          ],
          "required": true
        }
      ]
    }
  ]
}
